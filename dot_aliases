# Interactive rustup doc browser — fuzzy searches all ~2000 topics from local docs.
# Note: shadows the rustdoc compiler binary (rarely called directly; cargo doc wraps it).
# Rename to e.g. 'rdoc' if you need the real rustdoc in your PATH.
rust() {
    local docs
    docs=$(dirname "$(rustup doc --path 2>/dev/null)" 2>/dev/null)
    if [[ -z "$docs" || ! -d "$docs/std" ]]; then
        echo "rustup docs not found. Run: rustup component add rust-docs"
        return 1
    fi

    local selection
    selection=$(
        {
            # Named book flags pinned at top (description in middle, --flag at end for $NF extraction)
            printf '%-10s %-54s %s\n' \
                "book" "The Rust Programming Language book"               "--book" \
                "book" "Standard library API documentation"               "--std" \
                "book" "The Cargo Book"                                   "--cargo" \
                "book" "The Rust Reference"                               "--reference" \
                "book" "The Rust Core Library"                            "--core" \
                "book" "The Rust core allocation and collections library" "--alloc" \
                "book" "The Clippy Documentation"                         "--clippy" \
                "book" "The Rust Edition Guide"                           "--edition-guide" \
                "book" "The Embedded Rust Book"                           "--embedded-book" \
                "book" "The Rust Error Codes Index"                       "--error-codes" \
                "book" "The Dark Arts of Advanced and Unsafe Rust"        "--nomicon" \
                "book" "A support library for macro authors"              "--proc_macro" \
                "book" "Runnable examples illustrating Rust concepts"     "--rust-by-example" \
                "book" "The Rust compiler documentation"                  "--rustc" \
                "book" "Documentation generator for Rust projects"        "--rustdoc" \
                "book" "The Rust Style Guide"                             "--style-guide" \
                "book" "Unit-test and micro-benchmarking framework"       "--test" \
                "book" "The Unstable Book"                                "--unstable-book"

            # All std items + modules, sorted alphabetically by topic
            {
                # Modules (directories containing index.html)
                find "$docs/std" -mindepth 2 -name "index.html" -printf "%P\n" \
                    | sed 's|/index\.html$||; s|/|::|g' \
                    | awk '{printf "%-10s std::%s\n", "module", $0}'

                # Items — skip non-! macro duplicates (macro.foo.html) keeping macro.foo!.html
                find "$docs/std" -name "*.html" -printf "%P\n" \
                    | grep -v '^index\.html$' \
                    | grep -v '^all\.html$' \
                    | grep -v 'sidebar-items' \
                    | grep -v 'not_found' \
                    | grep -vE 'macro\.[^!]+\.html$' \
                    | awk -F/ '{
                        file=$NF; sub(/\.html$/, "", file)
                        dot=index(file,".")
                        kind=substr(file,1,dot-1)
                        name=substr(file,dot+1)
                        n=NF-1
                        if(n==0) { topic=name }
                        else { mod=$1; for(i=2;i<=n;i++) mod=mod"::"$i; topic="std::"mod"::"name }
                        printf "%-10s %s\n", kind, topic
                    }'
            } | sort -k2

        } | fzf --height=70% --reverse \
                --prompt='rustup doc > ' \
                --header='struct · fn · type · trait · constant · macro · enum · keyword · primitive · derive · attr · union · module · book' \
                --bind='tab:down,shift-tab:up'
    )

    [[ -z "$selection" ]] && return

    local topic
    topic=$(awk '{print $NF}' <<< "$selection")
    rustup doc "$topic"
}

# Interactive Python API browser — fuzzy searches builtins, keywords, and the
# stdlib modules most useful for LeetCode (collections, itertools, functools,
# heapq, bisect, math, string, re, operator, typing) plus str/list/dict/set/
# tuple methods. Pulled live from the installed interpreter's docstrings via
# pydoc3, so no separate docs package or internet connection is needed.
# Note: shadows the real 'pydoc' command (this system only ships 'pydoc3');
# rename this to e.g. 'pyd' if you need the stock pydoc CLI under this name.
pydoc() {
    local selection
    selection=$(
        python3 - <<'PYEOF' |
import inspect

modules = [
    "collections", "itertools", "functools", "heapq", "bisect",
    "math", "string", "re", "operator", "typing",
]

seen = set()

for modname in modules:
    mod = __import__(modname)
    if modname not in seen:
        seen.add(modname)
        doc = (inspect.getdoc(mod) or "").split("\n")[0]
        print(f"{'module':<10} {modname:<30} {doc}")
    for name, obj in inspect.getmembers(mod):
        if name.startswith("_"):
            continue
        full = f"{modname}.{name}"
        if full in seen:
            continue
        seen.add(full)
        kind = "class" if inspect.isclass(obj) else "function" if inspect.isroutine(obj) else "member"
        doc = (inspect.getdoc(obj) or "").split("\n")[0]
        print(f"{kind:<10} {full:<30} {doc}")

for typename in ("str", "list", "dict", "set", "tuple", "frozenset"):
    t = eval(typename)
    for name, obj in inspect.getmembers(t):
        if name.startswith("_"):
            continue
        full = f"{typename}.{name}"
        if full in seen:
            continue
        seen.add(full)
        doc = (inspect.getdoc(obj) or "").split("\n")[0]
        print(f"{'method':<10} {full:<30} {doc}")

import builtins, keyword
for kw in keyword.kwlist:
    if kw in seen:
        continue
    seen.add(kw)
    print(f"{'keyword':<10} {kw:<30}")

for name in dir(builtins):
    if name.startswith("_") or name in seen:
        continue
    obj = getattr(builtins, name)
    seen.add(name)
    kind = "class" if inspect.isclass(obj) else "function" if inspect.isroutine(obj) else "member"
    doc = (inspect.getdoc(obj) or "").split("\n")[0]
    print(f"{kind:<10} {name:<30} {doc}")
PYEOF
        fzf --height=90% --reverse \
            --prompt='python doc > ' \
            --header='module · class · function · method · member · keyword' \
            --tiebreak=begin \
            --color='hl:yellow,hl+:yellow' \
            --bind='tab:down,shift-tab:up'
    )

    [[ -z "$selection" ]] && return

    local topic
    topic=$(awk '{print $2}' <<< "$selection")
    pydoc3 "$topic"
}

# Interactive FastAPI (+ Starlette bits it re-exports) API browser — same
# mechanism as pydoc(): live inspect.getmembers() introspection, but scoped to
# fastapi and the submodules you actually import from day to day (security,
# responses, testclient, middleware.cors, staticfiles, params, ...). Uses
# whichever 'python3' is first on PATH, so activate your venv first if
# FastAPI lives there rather than globally.
fastapidoc() {
    if ! python3 -c "import fastapi" 2>/dev/null; then
        echo "fastapi not importable by 'python3'. Activate the venv that has it installed, or: pip install fastapi"
        return 1
    fi

    local selection
    selection=$(
        python3 - <<'PYEOF' |
import inspect

modules = [
    "fastapi", "fastapi.security", "fastapi.responses", "fastapi.testclient",
    "fastapi.encoders", "fastapi.exceptions", "fastapi.middleware",
    "fastapi.middleware.cors", "fastapi.staticfiles", "fastapi.templating",
    "fastapi.background", "fastapi.requests", "fastapi.websockets", "fastapi.params",
]

seen = set()
out = []

for modname in modules:
    try:
        mod = __import__(modname, fromlist=["_"])
    except Exception:
        continue
    if modname not in seen:
        seen.add(modname)
        doc = (inspect.getdoc(mod) or "").split("\n")[0]
        out.append(("module", modname, doc))
    for name, obj in inspect.getmembers(mod):
        if name.startswith("_") or inspect.ismodule(obj):
            continue
        full = f"{modname}.{name}"
        if full in seen:
            continue
        seen.add(full)
        kind = "class" if inspect.isclass(obj) else "function" if inspect.isroutine(obj) else "member"
        doc = (inspect.getdoc(obj) or "").split("\n")[0]
        out.append((kind, full, doc))

out.sort(key=lambda e: e[1])
for kind, topic, desc in out:
    print(f"{kind:<10} {topic:<32} {desc}")
PYEOF
        fzf --height=90% --reverse \
            --prompt='fastapi doc > ' \
            --header='module · class · function · member' \
            --tiebreak=begin \
            --color='hl:yellow,hl+:yellow' \
            --bind='tab:down,shift-tab:up'
    )

    [[ -z "$selection" ]] && return

    local topic
    topic=$(awk '{print $2}' <<< "$selection")
    pydoc3 "$topic"
}

# Fuzzy-search all crates in the current Cargo project's generated docs.
# Run `cargo doc` first if target/doc doesn't exist yet.
doc() {
    local root
    root=$(cargo locate-project --message-format plain 2>/dev/null)
    if [[ -z "$root" ]]; then
        echo "This command only works inside a Cargo project."
        return 1
    fi

    cargo doc 2>&1 || return 1

    local doc_dir
    doc_dir="$(dirname "$root")/target/doc"
    if [[ ! -d "$doc_dir" ]]; then
        local workspace_root
        workspace_root=$(cargo metadata --no-deps --format-version 1 2>/dev/null \
            | grep -o '"workspace_root":"[^"]*"' | sed 's|"workspace_root":"||;s|"||g')
        doc_dir="$workspace_root/target/doc"
    fi

    local selected
    selected=$(find "$doc_dir" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort | \
        fzf --height=50% --reverse --prompt='crate > ')
    [[ -z "$selected" ]] && return 0

    local all_html="$doc_dir/$selected/all.html"
    if [[ ! -f "$all_html" ]]; then
        echo "all.html not found for: $selected"
        return 1
    fi

    w3m "$all_html"
}

# Interactive Docker CLI browser — fuzzy searches every docker command and
# subcommand (run, container ls, image build, volume prune, compose up, ...)
# by recursively parsing `docker ... --help` output (up to 3 levels deep) live
# from your installed Docker CLI, so it always matches your installed version.
# Named 'ddoc' rather than 'docker' so it doesn't shadow the real docker CLI.
ddoc() {
    local selection
    selection=$(
        python3 - <<'PYEOF' |
import re
import subprocess

MAX_DEPTH = 3


def get_help(path):
    proc = subprocess.run(
        ["docker", *path, "--help"], capture_output=True, text=True, timeout=5
    )
    return proc.stdout


def parse_commands(text):
    section = None
    for line in text.splitlines():
        header = re.match(r"^(Common Commands|Management Commands|Swarm Commands|Commands):$", line)
        if header:
            section = header.group(1)
            continue
        if section is None:
            continue
        if not line.startswith(" "):
            section = None
            continue
        m = re.match(r"^ {2}(\S+)\s{2,}(.*)$", line)
        if m:
            name, desc = m.group(1), m.group(2).strip()
            is_group = section in ("Management Commands", "Swarm Commands")
            yield name.rstrip("*"), desc, is_group


def walk(path, depth, seen_paths, out):
    if depth > MAX_DEPTH:
        return
    key = tuple(path)
    if key in seen_paths:
        return
    seen_paths.add(key)

    for name, desc, is_group in parse_commands(get_help(path)):
        topic = path + [name]
        kind = "group" if is_group else "command"
        out.append((kind, "/".join(topic), desc))
        if is_group:
            walk(topic, depth + 1, seen_paths, out)


out = []
walk([], 0, set(), out)
out.sort(key=lambda e: e[1])
for kind, topic, desc in out:
    print(f"{kind:<10} {topic:<28} {desc}")
PYEOF
        fzf --height=90% --reverse \
            --prompt='docker doc > ' \
            --header='group · command  (path segments joined by /)' \
            --tiebreak=begin \
            --color='hl:yellow,hl+:yellow' \
            --bind='tab:down,shift-tab:up'
    )

    [[ -z "$selection" ]] && return

    local topic parts
    topic=$(awk '{print $2}' <<< "$selection")
    IFS='/' read -ra parts <<< "$topic"
    docker "${parts[@]}" --help
}

# Interactive git command browser — fuzzy searches all ~150 git commands
# (porcelain and plumbing) by parsing the GIT COMMANDS section of `man git`,
# so it always matches your installed git version. Named 'gdoc' since 'git'
# itself obviously can't be shadowed.
gdoc() {
    local selection
    selection=$(
        python3 - <<'PYEOF' |
import re
import subprocess

proc = subprocess.run(["man", "git"], capture_output=True, text=True)
if not proc.stdout:
    raise SystemExit("man git produced no output")
raw = subprocess.run(["col", "-b"], input=proc.stdout, capture_output=True, text=True).stdout
lines = raw.splitlines()

start = next(i for i, l in enumerate(lines) if l.strip() == "GIT COMMANDS")
end = next(i for i, l in enumerate(lines) if l.strip() == "CONFIGURATION MECHANISM")

category = None
entries = []
i = start
while i < end:
    line = lines[i]
    if line.strip() == "":
        i += 1
        continue
    indent = len(line) - len(line.lstrip(" "))
    text = line.strip()
    if indent == 3:
        category = text
        i += 1
        continue
    m = re.match(r"^git-([\w.-]+)\(1\)$", text) if indent == 7 else None
    if m:
        name = m.group(1)
        desc_lines = []
        j = i + 1
        while j < end and lines[j].strip() != "":
            desc_lines.append(lines[j].strip())
            j += 1
        entries.append((name, category, " ".join(desc_lines)))
        i = j
        continue
    i += 1

entries.sort(key=lambda e: e[0])
for name, cat, desc in entries:
    print(f"{'command':<10} {name:<20} ({cat}) {desc}")
PYEOF
        fzf --height=90% --reverse \
            --prompt='git doc > ' \
            --header='command  (category in parens)' \
            --tiebreak=begin \
            --color='hl:yellow,hl+:yellow' \
            --bind='tab:down,shift-tab:up'
    )

    [[ -z "$selection" ]] && return

    local topic
    topic=$(awk '{print $2}' <<< "$selection")
    git help "$topic"
}

# Interactive uv (Python package manager) CLI browser — fuzzy searches every
# uv command and subcommand (add, sync, pip install, tool install, python
# pin, ...) by recursively parsing `uv ... --help`, live from your installed
# uv, up to 3 levels deep. Named 'uvdoc' so it doesn't shadow the real 'uv'.
uvdoc() {
    local selection
    selection=$(
        python3 - <<'PYEOF' |
import re
import subprocess

MAX_DEPTH = 3


def get_help(path):
    proc = subprocess.run(["uv", *path, "--help"], capture_output=True, text=True, timeout=5)
    return proc.stdout


def parse_commands(text):
    entries = []
    capturing = False
    for line in text.splitlines():
        if line == "Commands:":
            capturing = True
            continue
        if not capturing:
            continue
        if line.strip() == "":
            break
        m = re.match(r"^ {2}(\S+)\s{2,}(.*)$", line)
        if m:
            entries.append((m.group(1), m.group(2).strip()))
    return entries


def walk(path, depth, seen, out, desc=""):
    if depth > MAX_DEPTH:
        return
    key = tuple(path)
    if key in seen:
        return
    seen.add(key)

    entries = parse_commands(get_help(path))
    if path:
        kind = "group" if entries else "command"
        out.append((kind, "/".join(path), desc))
    for name, sdesc in entries:
        walk(path + [name], depth + 1, seen, out, sdesc)


out = []
walk([], 0, set(), out)
out.sort(key=lambda e: e[1])
for kind, topic, desc in out:
    print(f"{kind:<10} {topic:<20} {desc}")
PYEOF
        fzf --height=90% --reverse \
            --prompt='uv doc > ' \
            --header='group · command  (path segments joined by /)' \
            --tiebreak=begin \
            --color='hl:yellow,hl+:yellow' \
            --bind='tab:down,shift-tab:up'
    )

    [[ -z "$selection" ]] && return

    local topic parts
    topic=$(awk '{print $2}' <<< "$selection")
    IFS='/' read -ra parts <<< "$topic"
    uv "${parts[@]}" --help
}


