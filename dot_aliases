# Functions for disk reporting and creating bootable USB drives.
diskreport() {
  RED="\e[31m"
  GREEN="\e[32m"
  CYAN="\e[36m"
  YELLOW="\e[33m"
  BOLD="\e[1m"
  RESET="\e[0m"

  echo -e "${BOLD}${CYAN}=== 🔎 Disk and OS Information Report ===${RESET}\n"
  echo -e "${YELLOW}👉 Physical Disks and Partitions:${RESET}"
  lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINT,TYPE | grep -E "disk|part" | grep -v "loop"
  echo
  echo -e "${YELLOW}👉 Detailed Partition Layout (fdisk):${RESET}"
  sudo fdisk -l | grep -E "Disk /dev/(sd|nvme)"
  echo
  echo -e "${YELLOW}👉 Currently Mounted Filesystems:${RESET}"
  mount | grep '^/dev/' | grep -v "loop"
  echo
  echo -e "${YELLOW}👉 UEFI Boot Entries (Bootloaders in firmware):${RESET}"
  sudo efibootmgr -v
  echo
  echo -e "${YELLOW}👉 Current Linux Distribution:${RESET}"
  grep -E 'PRETTY_NAME|VERSION=' /etc/os-release
  echo
  echo -e "${YELLOW}👉 Kernel and System Architecture:${RESET}"
  uname -a
  echo
  echo -e "${YELLOW}👉 Checking for Windows Partitions (NTFS):${RESET}"
  lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINT,TYPE | grep ntfs || echo -e "${RED}No Windows partitions found.${RESET}"
  echo
  echo -e "${GREEN}${BOLD}=== ✅ Report Complete ===${RESET}"
}

burnWindowUSB(){
  local iso="${1:-Windows_ISO_Placeholder.iso}"
  local drive="${2:-/dev/sdX}"
  local woeusb_url="https://github.com/WoeUSB/WoeUSB/releases/download/v5.2.4/woeusb-5.2.4.bash"
  local woeusb_bin="/usr/local/bin/woeusb"

  # Sanity checks
  if [[ "$drive" == "/dev/sdX" ]]; then
    echo "ERROR: Please specify your USB drive as the second argument, e.g.:"
    echo "  burnWindowUSB Windows.iso /dev/sdb"
    echo "Run 'diskreport' to identify your USB device."
    return 1
  fi
  if [[ ! -f "$iso" ]]; then
    echo "ERROR: ISO file not found: $iso"
    return 1
  fi

  # Install dependencies
  echo "==> Installing WoeUSB dependencies..."
  sudo apt-get install -y \
    wimtools \
    cabextract \
    genisoimage \
    ntfs-3g \
    parted \
    grub-pc-bin \
    grub-efi-amd64-bin \
    util-linux

  # Download woeusb if not already present
  if [[ ! -x "$woeusb_bin" ]]; then
    echo "==> Downloading WoeUSB..."
    sudo curl -fsSL "$woeusb_url" -o "$woeusb_bin"
    sudo chmod +x "$woeusb_bin"
  else
    echo "==> WoeUSB already installed at $woeusb_bin"
  fi

  # Burn
  echo "==> Burning '$iso' to '$drive' (this may take 1-2 hours)..."
  sudo "$woeusb_bin" --target-filesystem NTFS --device "$iso" "$drive"
}

burnLinuxUSB(){
  echo '1. run "diskrepot" command and find the mounted usb device, usually /dev/sda or /dev/sdb'
  echo '2. sudo dd if=linux.iso of=/dev/sdb bs=4M status=progress oflag=sync'
  echo "3. takes about 1-2 hours to burn to usb"
}


